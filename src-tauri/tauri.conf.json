{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kasarat",
  "version": "4.0.0",
  "identifier": "com.kasarat.management",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "نظام إدارة الكسارات",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "نظام إدارة الكسارات والمبيعات والمخزون",
    "shortDescription": "نظام إدارة الكسارات",
    "copyright": "© 2026",
    "category": "Business",
    "resources": []
  }
}